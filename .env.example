# ==============================================================================
# Pramana TwinCare Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Render Web Service)
# ------------------------------------------------------------------------------
# In production on Render:
# - PORT is automatically injected by Render (default 10000). Leave unset or default.
# - ENVIRONMENT should be set to "production".
# - ALLOWED_ORIGINS must be set to your deployed Vercel domain (NO wildcard *).
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In production on Render, set:
# ALLOWED_ORIGINS=https://your-twincare.vercel.app
# ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Artifact and Data Directory Settings
# Relative to backend/ or absolute path
ARTIFACTS_DIR=./artifacts

# Persistent Storage (Required for persistent registered patients and audit logs on Render)
# If using a Render Persistent Disk mounted at /var/data:
# DATA_DIR=/var/data
# AUDIT_LOG_PATH=/var/data/inference_audit.jsonl
# REGISTERED_PATIENTS_PATH=/var/data/registered_patients.json
DATA_DIR=./data
AUDIT_LOG_PATH=./inference_audit.jsonl

# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables.
# It must point to your deployed Render backend (NO trailing slash).
# Local development default: http://localhost:8000
# Production example: https://twincare-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
